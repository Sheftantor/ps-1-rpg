[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/start_menu.gd" id="1_menu"]
[ext_resource type="Script" path="res://scripts/ui/win95/win95_window.gd" id="2_window"]

[node name="StartMenu" type="CanvasLayer"]
script = ExtResource("1_menu")

[node name="Control" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Backdrop" type="Panel" parent="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"DesktopPanel"

[node name="MainWindow" type="Container" parent="Control"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -100.0
offset_right = 360.0
offset_bottom = 100.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("2_window")
title = "PS1-RPG"
tag = "v0.1"
collapse_when_empty = true

[node name="MainMenu" type="VBoxContainer" parent="Control/MainWindow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"WindowBody"

[node name="Logo" type="Label" parent="Control/MainWindow/MainMenu"]

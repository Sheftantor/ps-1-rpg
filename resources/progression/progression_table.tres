[resource]
script = ExtResource("1_table")
levels = Array[ExtResource("2_row")]([SubResource("Level1"), SubResource("Level2"), SubResource("Level3"), SubResource("Level4"), SubResource("Level5"), SubResource("Level6"), SubResource("Level7"), SubResource("Level8"), SubResource("Level9"), SubResource("Level10"), SubResource("Level11"), SubResource("Level12"), SubResource("Level13"), SubResource("Level14"), SubResource("Level15"), SubResource("Level16"), SubResource("Level17"), SubResource("Level18"), SubResource("Level19"), SubResource("Level20")])
classes = Array[ExtResource("3_class")]([ExtResource("class_warrior"), ExtResource("class_gunner"), ExtResource("class_sneak"), ExtResource("class_memer")])
abilities = Array[ExtResource("4_ability")]([ExtResource("ability_rush_attack"), ExtResource("ability_line_shot"), ExtResource("ability_back_stab"), ExtResource("ability_strong_summon"), ExtResource("ability_summon")])
unlocks = Array[ExtResource("5_unlock")]([SubResource("Unlock_rush_attack"), SubResource("Unlock_line_shot"), SubResource("Unlock_back_stab"), SubResource("Unlock_strong_summon"), SubResource("Unlock_summon")])
notes = "PLACEHOLDER formulas behind the level rows: stat points 1 per level (+1 at 5/10/15/20, 0 at level 1); health per point 5 + 0.5 per level; energy per point 3 + 0.25 per level; energy-mode meter fill x1.0 + 0.04 per level; ability multipliers 1.0 + per level: rush 0.15, line shot 0.14, back stab 0.18, strong summon 0.16, summon 0.10. Stat rules are placeholders too: base_stat 10, abilities +6% per point of their own stat, weapons +1% per point capped at +25%. Unlock levels / memes: see each unlock row."
